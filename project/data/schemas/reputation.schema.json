{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "schema version 1 (SE-030). 변경 이력: docs/gdd/reputation.md#변경-이력. 구조를 바꾸면 version enum 을 올리고 reputation.md 변경 이력에 적는다.",
  "title": "reputation",
  "description": "명성 시스템 수치(공연 등급별 기본 명성, 입장 계수, 장르 집중/확산 보정, 해금 판정 상한, 기준 시나리오). 규칙: docs/gdd/reputation.md. 티어 해금 임계(명성·자금)는 tiers.json, 섭외 등급 해금 명성은 artist.json grades[].unlock_reputation 이 단일 출처이고 이 표는 복제하지 않는다(artist.md AR14). 장르 유사도는 genres.json affinity. 비율은 economy.json rate_scale(10000) 분의 정수 bp. 수치 변경은 game-designer 만.",
  "type": "object",
  "required": ["version", "base_by_grade", "admission_factor", "focus", "tier_unlock", "checks", "reference_scenarios"],
  "additionalProperties": false,
  "$defs": {
    "bp": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "show_grade": { "type": "string", "enum": ["disaster", "poor", "ok", "good", "rave"] },
    "genre_id": { "type": "string", "enum": ["rock", "hiphop", "electronic", "indie", "jazz", "pop", "metal", "world"] },
    "focus_kind": { "type": "string", "enum": ["none", "identity", "breadth"] },
    "int_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } },
    "day_or_null": { "type": ["integer", "null"], "minimum": 1 },
    "show_input": {
      "description": "하루 공연 입력(show.started.genre, audience 평균 만족 → show.json 등급, show.ended.admissions). null 이면 그날은 show.skipped",
      "type": ["object", "null"],
      "required": ["genre", "satisfaction_bp", "admissions"],
      "additionalProperties": false,
      "properties": {
        "genre": { "$ref": "#/$defs/genre_id" },
        "satisfaction_bp": { "$ref": "#/$defs/bp" },
        "admissions": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "base_by_grade": {
      "description": "공연 등급별 기본 명성 변화(RP2). 키 = artist.json show_grades 전부(로더 RL2). show_grades 순서로 엄격히 증가, 실패 등급(disaster·poor)은 음수, 나머지는 양수(RL4)",
      "type": "object",
      "required": ["disaster", "poor", "ok", "good", "rave"],
      "additionalProperties": false,
      "properties": {
        "disaster": { "type": "integer", "maximum": -1 },
        "poor": { "type": "integer", "maximum": -1 },
        "ok": { "type": "integer", "minimum": 1 },
        "good": { "type": "integer", "minimum": 1 },
        "rave": { "type": "integer", "minimum": 1 }
      }
    },
    "admission_factor": {
      "description": "입장 계수(RP3): clamp(admissions × 10000 ÷ admissions_ref, min_bp, max_bp)",
      "type": "object",
      "required": ["admissions_ref", "min_bp", "max_bp"],
      "additionalProperties": false,
      "properties": {
        "admissions_ref": { "description": "계수 10000 이 되는 입장 수(economy 기준 공연 100명)", "type": "integer", "minimum": 1 },
        "min_bp": { "description": "계수 하한. 실패 등급 Δ 가 0 이 되지 않게 ⌊|base| × min_bp ÷ 10000⌋ ≥ 1(RL4)", "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_bp": { "description": "계수 상한(≥ min_bp, RL5)", "type": "integer", "minimum": 1, "maximum": 50000 }
      }
    },
    "focus": {
      "description": "장르 집중(정체성)/확산(관객 폭) 보정(RP4). 양수 Δ 에만 곱한다",
      "type": "object",
      "required": ["min_genre_sum", "identity_share_bp", "identity_bonus_bp", "breadth_min_share_bp", "breadth_bonus_bp"],
      "additionalProperties": false,
      "properties": {
        "min_genre_sum": { "description": "장르별 명성 합이 이 값 이상일 때만 보정을 판정한다", "type": "integer", "minimum": 1 },
        "identity_share_bp": { "description": "유사도 가중 점유율이 이 값 이상이면 정체성 보너스", "$ref": "#/$defs/bp" },
        "identity_bonus_bp": { "$ref": "#/$defs/bp" },
        "breadth_min_share_bp": { "description": "MVP 장르 전부의 점유율이 이 값 이상이면(정체성이 아닐 때) 관객 폭 보너스. × 장르 수 ≤ 10000(RL6)", "$ref": "#/$defs/bp" },
        "breadth_bonus_bp": { "$ref": "#/$defs/bp" }
      }
    },
    "tier_unlock": {
      "description": "티어 해금 판정(TU1~TU4). 임계는 tiers.json rows[].unlock_reputation·unlock_cash",
      "type": "object",
      "required": ["max_tier"],
      "additionalProperties": false,
      "properties": {
        "max_tier": { "description": "알림을 낼 수 있는 가장 높은 티어. MVP 는 2(티어 2 맵은 버티컬 슬라이스). tiers.json tier 범위 안(RL7)", "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "checks": {
      "description": "수치 목표(qa·테스트용, 런타임은 읽지 않는다). reputation.md #수치-목표",
      "type": "object",
      "required": ["tier2_reputation_day_range", "rookie_unlock_day_range", "tier2_reputation_cash_gap_max_days", "main_scenario"],
      "additionalProperties": false,
      "properties": {
        "tier2_reputation_day_range": { "description": "main_scenario 에서 명성이 티어 2 임계에 닿는 날의 허용 범위(RT1)", "$ref": "#/$defs/int_range" },
        "rookie_unlock_day_range": { "description": "main_scenario 에서 명성이 artist.json rookie 해금 임계에 닿는 날의 허용 범위(artist.md T6, RT2)", "$ref": "#/$defs/int_range" },
        "tier2_reputation_cash_gap_max_days": { "description": "main_scenario 에서 명성 도달일과 자금 도달일의 차 상한(RT3)", "type": "integer", "minimum": 0 },
        "main_scenario": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "reference_scenarios": {
      "description": "기준 시나리오(테스트·qa 용, 런타임은 읽지 않는다). 하루 d 의 공연 = show_cycle[(d − 1) mod len], 정산 현금 = cash.start + cash.per_day × d. reputation.md #기준-시나리오",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "days", "show_cycle", "cash", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string" },
          "days": { "type": "integer", "minimum": 1 },
          "show_cycle": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/show_input" } },
          "cash": {
            "description": "economy.day_settled.cash 입력 계열",
            "type": "object",
            "required": ["start", "per_day"],
            "additionalProperties": false,
            "properties": { "start": { "type": "integer" }, "per_day": { "type": "integer" } }
          },
          "cash_from_economy_scenario": { "description": "cash 가 이 economy.json reference_scenarios[].id 의 일자 검증(시작 − 건설 + 매일 net)과 같음", "type": "string" },
          "expected": {
            "type": "object",
            "required": ["grade", "factor_bp", "focus", "computed_delta", "delta", "total", "by_genre_final", "tier_unlocked_days", "day_reach_rookie_unlock", "day_reach_tier2_reputation", "day_reach_tier2_cash"],
            "additionalProperties": false,
            "properties": {
              "grade": { "description": "날마다(공연 없는 날 null)", "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/show_grade" }, { "type": "null" }] } },
              "factor_bp": { "type": "array", "items": { "type": ["integer", "null"] } },
              "focus": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/focus_kind" }, { "type": "null" }] } },
              "computed_delta": { "description": "RP5 의 Δ(하한 적용 전)", "type": "array", "items": { "type": ["integer", "null"] } },
              "delta": { "description": "reputation.changed.delta(하한 적용 뒤 실제 변화)", "type": "array", "items": { "type": ["integer", "null"] } },
              "total": { "description": "그날 끝의 종합 명성", "type": "array", "items": { "type": "integer", "minimum": 0 } },
              "by_genre_final": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              },
              "tier_unlocked_days": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
              "day_reach_rookie_unlock": { "$ref": "#/$defs/day_or_null" },
              "day_reach_tier2_reputation": { "$ref": "#/$defs/day_or_null" },
              "day_reach_tier2_cash": { "$ref": "#/$defs/day_or_null" }
            }
          }
        }
      }
    }
  }
}
